# Bridge — systemd unit
#
# Install:
#   sudo cp examples/bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bridge
#
# Logs:
#   journalctl -u bridge -f
#
# Status:
#   systemctl status bridge
#
# This unit assumes:
#   - bridge is installed globally and on PATH (npm install -g @atlascrew/bridge)
#   - /etc/bridge/config.yaml exists (see examples/production.yaml)
#   - The 'bridge' system user owns /var/lib/bridge/

[Unit]
Description=Bridge — Atlas Crew Security Service Orchestrator
Documentation=https://github.com/atlas-crew/bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bridge
Group=bridge
WorkingDirectory=/var/lib/bridge

# Configuration
Environment=NODE_ENV=production
Environment=CONFIG_PATH=/etc/bridge/config.yaml
Environment=PORT=4200
Environment=HOST=127.0.0.1

# The full path to bridge — adjust if installed via a node version manager
ExecStart=/usr/bin/bridge start

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=3

# Logging — captured by journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bridge

# Graceful shutdown — must exceed shutdownGracePeriodMs in config.yaml
TimeoutStopSec=20s
KillSignal=SIGTERM
KillMode=mixed

# ── Hardening ──────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true

# Bridge needs write access to its data directory
ReadWritePaths=/var/lib/bridge

# Bridge spawns child processes — needs to keep new privs available to them
# (override NoNewPrivileges if managed services need elevated privs; they shouldn't)

[Install]
WantedBy=multi-user.target
