---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Not found"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <main class="flex-1 flex items-center justify-center px-6 py-24">
    <div class="max-w-md text-center">
      <p class="type-tag text-[0.8rem] text-[var(--color-brand-orange)] mb-3">404 — Not found</p>
      <h1 class="type-display text-[2.5rem] text-[var(--color-text)] mb-3">This route hasn't shipped.</h1>
      <p class="type-body text-[0.95rem] text-[var(--color-text-dim)] mb-8 leading-relaxed">
        The page you're looking for doesn't exist on bridge.atlascrew.dev. Try one of these instead:
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="type-nav rounded-md bg-[var(--color-brand-blue)] px-4 py-2 text-[0.85rem] text-white hover:opacity-90">Home</a>
        <a href="/install" class="type-nav rounded-md border border-[var(--color-border)] px-4 py-2 text-[0.85rem] text-[var(--color-text)] hover:border-[var(--color-brand-blue)] hover:text-[var(--color-brand-blue)]">Install</a>
        <a href="/configuration" class="type-nav rounded-md border border-[var(--color-border)] px-4 py-2 text-[0.85rem] text-[var(--color-text)] hover:border-[var(--color-brand-blue)] hover:text-[var(--color-brand-blue)]">Configuration</a>
      </div>
    </div>
  </main>
</BaseLayout>
