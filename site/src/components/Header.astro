---
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || (p !== '/' && path.startsWith(p));

const links = [
  { href: '/install', label: 'Install' },
  { href: '/architecture', label: 'Architecture' },
  { href: '/services', label: 'Services' },
  { href: '/configuration', label: 'Config' },
  { href: '/dashboard', label: 'Dashboard' },
  { href: '/cli', label: 'CLI' },
  { href: '/api', label: 'API' },
  { href: '/deployment', label: 'Deploy' },
];
---

<header class="sticky top-0 z-30 border-b border-[var(--color-border)] bg-[color:var(--color-surface)]/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-6 py-3">
    <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-80" aria-label="Bridge home">
      <img src="/brand/icons/bridge-icon.svg" alt="" width="32" height="32" class="block" />
      <span class="hidden flex-col items-start sm:flex">
        <span class="type-heading text-[1.05rem] leading-none text-[var(--color-text)]">Bridge</span>
        <span class="type-label mt-1 text-[0.65rem] text-[var(--color-text-muted)]">Service Orchestrator</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'rounded-md px-2.5 py-1.5 type-nav text-[0.78rem] transition-colors',
            isActive(l.href)
              ? 'bg-[color:var(--color-brand-blue)]/10 text-[var(--color-brand-blue)]'
              : 'text-[var(--color-text-dim)] hover:bg-[color:var(--color-surface-raised)] hover:text-[var(--color-text)]',
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="https://github.com/atlas-crew/Bridge"
        target="_blank"
        rel="noopener noreferrer"
        class="type-nav rounded-md border border-[var(--color-border)] px-3 py-1.5 text-[0.78rem] text-[var(--color-text-dim)] transition-colors hover:border-[var(--color-brand-blue)] hover:text-[var(--color-brand-blue)]"
        aria-label="GitHub repository"
      >
        GitHub
      </a>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav class="md:hidden border-t border-[var(--color-border)] overflow-x-auto" aria-label="Primary mobile">
    <ul class="flex items-center gap-1 px-4 py-2 whitespace-nowrap">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={[
              'rounded-md px-2.5 py-1.5 type-nav text-[0.7rem]',
              isActive(l.href)
                ? 'bg-[color:var(--color-brand-blue)]/10 text-[var(--color-brand-blue)]'
                : 'text-[var(--color-text-dim)]',
            ]}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
