---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] bg-[color:var(--color-surface)] mt-16">
  <div class="mx-auto max-w-[1280px] px-6 py-10 grid gap-8 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-3 mb-3">
        <img src="/brand/icons/bridge-icon.svg" alt="" width="32" height="32" />
        <span class="type-heading text-[1.05rem] text-[var(--color-text)]">Bridge</span>
      </div>
      <p class="type-body text-[0.85rem] text-[var(--color-text-dim)] max-w-md leading-relaxed">
        Service orchestration layer for the Atlas Crew Security stack. Single-host process supervisor with a real-time web dashboard.
      </p>
    </div>

    <div>
      <h4 class="type-label mb-3 text-[0.7rem] text-[var(--color-text-muted)]">Project</h4>
      <ul class="space-y-1.5 type-body text-[0.85rem]">
        <li><a href="/install" class="text-[var(--color-text-dim)] hover:text-[var(--color-brand-blue)]">Install</a></li>
        <li><a href="/configuration" class="text-[var(--color-text-dim)] hover:text-[var(--color-brand-blue)]">Configuration</a></li>
        <li><a href="/cli" class="text-[var(--color-text-dim)] hover:text-[var(--color-brand-blue)]">CLI reference</a></li>
        <li><a href="/api" class="text-[var(--color-text-dim)] hover:text-[var(--color-brand-blue)]">API reference</a></li>
      </ul>
    </div>

    <div>
      <h4 class="type-label mb-3 text-[0.7rem] text-[var(--color-text-muted)]">Resources</h4>
      <ul class="space-y-1.5 type-body text-[0.85rem]">
        <li><a href="https://github.com/atlas-crew/Bridge" class="text-[var(--color-text-dim)] hover:text-[var(--color-brand-blue)]">GitHub</a></li>
        <li><a href="https://www.npmjs.com/package/@atlascrew/bridge" class="text-[var(--color-text-dim)] hover:text-[var(--color-brand-blue)]">npm package</a></li>
        <li><a href="https://hub.docker.com/r/nickcrew/bridge" class="text-[var(--color-text-dim)] hover:text-[var(--color-brand-blue)]">Docker Hub</a></li>
        <li><a href="https://atlascrew.dev" class="text-[var(--color-text-dim)] hover:text-[var(--color-brand-blue)]">Atlas Crew</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-[1280px] px-6 py-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-2">
      <p class="type-data text-[0.75rem] text-[var(--color-text-muted)]">
        © {year} Atlas Crew Security · MIT License
      </p>
      <p class="type-data text-[0.75rem] text-[var(--color-text-muted)]">
        Typeset in <a href="https://www.recursive.design" class="text-[var(--color-text-dim)] hover:text-[var(--color-brand-blue)]">Recursive</a>
      </p>
    </div>
  </div>
</footer>
